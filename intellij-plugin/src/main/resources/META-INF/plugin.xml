<idea-plugin require-restart="true" url="https://github.com/Taimoor-Joyyah/glsl-support-jetbrains">
    <id>com.glslsupport.language</id>
    <name>GLSL Support (OpenGL/Vulkan)</name>
    <version>1.3.1</version>
    <vendor email="mtaimoor0167@gmail.com" url="https://github.com/Taimoor-Joyyah">Taimoor Joyyah</vendor>
    <description><![CDATA[
        <p>Edit and validate OpenGL and Vulkan shaders on Windows x64 with the bundled glslang compiler.</p>
        <ul>
            <li>Navigate shader symbols and includes, find usages and rename across project files.</li>
            <li>Set GLSL code style, complete layout qualifiers and configure shader targets, variants and pipelines.</li>
            <li>Inspect block memory layouts, browse SPIR-V alongside the source and search the OpenGL reference. Visited pages are available offline.</li>
        </ul>
        <p>Requires a Windows x64 IDE on IntelliJ Platform 2026.1 or later. All shader analysis runs locally.
        AI-assisted tools were used during development.</p>
    ]]></description>
    <change-notes><![CDATA[
        <ul>
            <li>Unused-local inspections and struct field completion do less work in large shaders. Editing a header reuses the include graphs of unaffected stages.</li>
            <li>Search pipeline names in settings and in the status-bar selector. Rerun validation directly from its results.</li>
            <li>Reopen SPIR-V, Layout and Trace in their existing tabs. Layout follows the new caret location, and SPIR-V source navigation uses a background index.</li>
            <li>Filter trace comparisons to changed entries and press Enter to open a directive in the editor.</li>
            <li>Search OpenGL Docs with qualified names such as GL.glBindTexture and glad_glBindTexture. Retry a failed page directly.</li>
        </ul>
    ]]></change-notes>
    <idea-version since-build="261"/>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <dependencies>
        <plugin id="com.intellij.modules.os.windows"/>
        <plugin id="com.intellij.modules.arch.x86_64"/>
    </dependencies>
    <depends optional="true" config-file="glsl-support-jcef.xml">com.intellij.modules.jcef</depends>
    <incompatible-with>com.glsl_analyzer.intellij</incompatible-with>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="GLSL" language="GLSL" implementationClass="com.glslsupport.ide.GlslLanguage$Type" fieldName="INSTANCE" extensions="glsl;glslh;vert;vs;tesc;tese;geom;frag;fs;comp;mesh;task;rgen;rint;rahit;rchit;rmiss;rcall"/>
        <lang.parserDefinition language="GLSL" implementationClass="com.glslsupport.ide.GlslLanguage$Parser"/>
        <stubElementTypeHolder class="com.glslsupport.ide.GlslLanguage$Elements"/>
        <stubIndex implementation="com.glslsupport.ide.GlslLanguage$SymbolIndex"/>
        <lang.findUsagesProvider language="GLSL" implementationClass="com.glslsupport.ide.Navigation$Usages"/>
        <gotoSymbolContributor implementation="com.glslsupport.ide.Navigation$Symbols"/>
        <renamePsiElementProcessor implementation="com.glslsupport.ide.ShaderRename"/>
        <projectService serviceImplementation="com.glslsupport.ide.Settings"/>
        <projectService serviceImplementation="com.glslsupport.ide.PipelineContexts"/>
        <statusBarWidgetFactory id="GlslPipelineContext" implementation="com.glslsupport.ide.ContextWidget"/>
        <lang.syntaxHighlighterFactory language="GLSL" implementationClass="com.glslsupport.ide.Appearance$Factory"/>
        <colorSettingsPage implementation="com.glslsupport.ide.Appearance$Colors"/>
        <annotator language="GLSL" implementationClass="com.glslsupport.ide.Appearance$Semantic"/>
        <externalAnnotator language="GLSL" implementationClass="com.glslsupport.ide.Diagnostics"/>
        <completion.contributor language="GLSL" implementationClass="com.glslsupport.ide.EditorFeatures$Complete"/>
        <lang.documentationProvider language="GLSL" implementationClass="com.glslsupport.ide.EditorFeatures$Docs"/>
        <lang.foldingBuilder language="GLSL" implementationClass="com.glslsupport.ide.EditorFeatures$Folds"/>
        <extendWordSelectionHandler implementation="com.glslsupport.ide.EditorFeatures$Select"/>
        <lang.psiStructureViewFactory language="GLSL" implementationClass="com.glslsupport.ide.EditorFeatures$Structure"/>
        <formattingService implementation="com.glslsupport.ide.EditorFeatures$Format" order="first"/>
        <typedHandler implementation="com.glslsupport.ide.EditorFeatures$OnType"/>
        <langCodeStyleSettingsProvider implementation="com.glslsupport.ide.GlslCodeStyle"/>
        <lang.commenter language="GLSL" implementationClass="com.glslsupport.ide.EditorFeatures$Comments"/>
        <defaultLiveTemplates file="liveTemplates/GLSL.xml"/>
        <internalFileTemplate name="GLSL Any Hit"/>
        <internalFileTemplate name="GLSL Callable"/>
        <internalFileTemplate name="GLSL Closest Hit"/>
        <internalFileTemplate name="GLSL Compute Shader"/>
        <internalFileTemplate name="GLSL Empty Shader"/>
        <internalFileTemplate name="GLSL Fragment Shader"/>
        <internalFileTemplate name="GLSL Geometry Shader"/>
        <internalFileTemplate name="GLSL Header"/>
        <internalFileTemplate name="GLSL Intersection"/>
        <internalFileTemplate name="GLSL Mesh Shader"/>
        <internalFileTemplate name="GLSL Miss"/>
        <internalFileTemplate name="GLSL Ray Generation"/>
        <internalFileTemplate name="GLSL Task Shader"/>
        <internalFileTemplate name="GLSL Tess Control Shader"/>
        <internalFileTemplate name="GLSL Tess Evaluation Shader"/>
        <internalFileTemplate name="GLSL Vertex Shader"/>
        <liveTemplateContext contextId="GLSL" implementation="com.glslsupport.ide.EditorFeatures$Templates"/>
        <codeInsight.parameterInfo language="GLSL" implementationClass="com.glslsupport.ide.Calls$Parameters"/>
        <codeInsight.declarativeInlayProvider language="GLSL" implementationClass="com.glslsupport.ide.Calls$Hints"
            providerId="glsl.parameter.names" group="PARAMETERS_GROUP" isEnabledByDefault="true"
            bundle="messages.GlslHints" nameKey="parameter.names" descriptionKey="parameter.names.description"/>
        <colorProvider implementation="com.glslsupport.ide.Calls$Colors"/>
        <typeDeclarationProvider implementation="com.glslsupport.ide.SymbolNavigation$Types"/>
        <definitionsScopedSearch implementation="com.glslsupport.ide.SymbolNavigation$Implementations"/>
        <callHierarchyProvider language="GLSL" implementationClass="com.glslsupport.ide.SymbolNavigation$Hierarchy"/>
        <localInspection language="GLSL" shortName="GlslSupportAnalysis" displayName="GLSL declarations, directives and unreachable code" groupName="GLSL" enabledByDefault="true" level="WEAK WARNING" implementationClass="com.glslsupport.ide.Inspections"/>
        <projectService serviceImplementation="com.glslsupport.ide.CompilerSupport"/>
        <projectConfigurable id="glslsupport.settings" parentId="language" displayName="GLSL Support" instance="com.glslsupport.ide.SettingsUI"/>
        <toolWindow id="Shader Variants" anchor="right" icon="/icons/variants.svg" factoryClass="com.glslsupport.ide.Variants"/>
        <toolWindow id="GLSL Pipelines" anchor="right" icon="/icons/pipeline.svg" factoryClass="com.glslsupport.ide.PipelinePanel$Window"/>
        <toolWindow id="GLSL Inspector" anchor="right" icon="/icons/inspector.svg" canCloseContents="true" factoryClass="com.glslsupport.ide.ShaderViews"/>
        <toolWindow id="OpenGL Docs" anchor="right" icon="/icons/docs.svg" factoryClass="com.glslsupport.ide.ReferenceDocs"/>
        <intentionAction><className>com.glslsupport.ide.Intentions$Version</className><category>GLSL</category></intentionAction>
        <intentionAction><className>com.glslsupport.ide.Intentions$Extension</className><category>GLSL</category></intentionAction>
        <intentionAction><className>com.glslsupport.ide.Intentions$Include</className><category>GLSL</category></intentionAction>
        <intentionAction><className>com.glslsupport.ide.Intentions$Main</className><category>GLSL</category></intentionAction>
        <intentionAction><className>com.glslsupport.ide.Intentions$Ifdef</className><category>GLSL</category></intentionAction>
        <intentionAction><className>com.glslsupport.ide.Intentions$Ifndef</className><category>GLSL</category></intentionAction>
        <intentionAction><className>com.glslsupport.ide.Intentions$Define</className><category>GLSL</category></intentionAction>
    </extensions>
    <applicationListeners>
        <listener class="com.glslsupport.ide.Diagnostics$Saved" topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </applicationListeners>
    <actions>
        <action id="GlslSupport.SearchReference" class="com.glslsupport.ide.ReferenceDocs$Search" text="Search OpenGL Docs" icon="/icons/docs.svg"><add-to-group group-id="ToolsMenu" anchor="last"/></action>
        <action id="GlslSupport.OpenReference" class="com.glslsupport.ide.ReferenceDocs$Open" text="Open OpenGL Reference" icon="/icons/docs.svg"><add-to-group group-id="EditorPopupMenu" anchor="last"/></action>
        <action id="GlslSupport.New" class="com.glslsupport.ide.Templates" text="GLSL Shader or Header" icon="/icons/shader.svg"><add-to-group group-id="NewGroup" anchor="last"/></action>
        <action id="GlslSupport.Spirv" class="com.glslsupport.ide.ShaderViews$Spirv" text="Show SPIR-V" icon="/icons/inspector.svg"><add-to-group group-id="EditorPopupMenu" anchor="last"/></action>
        <action id="GlslSupport.Layout" class="com.glslsupport.ide.ShaderViews$Layout" text="Show GLSL Block Layout" icon="/icons/inspector.svg"><add-to-group group-id="EditorPopupMenu" anchor="last"/></action>
        <action id="GlslSupport.Inline" class="com.glslsupport.ide.Actions$Inline" text="Inline GLSL Local Variable" icon="AllIcons.Actions.RefactoringBulb"><add-to-group group-id="RefactoringMenu" anchor="last"/></action>
        <action id="GlslSupport.Extract" class="com.glslsupport.ide.Actions$Extract" text="Extract GLSL Function" icon="AllIcons.Nodes.Function"><add-to-group group-id="RefactoringMenu" anchor="last"/></action>
        <action id="GlslSupport.Pipeline" class="com.glslsupport.ide.Actions$Pipeline" text="Validate GLSL Pipeline" icon="/icons/pipeline.svg"><add-to-group group-id="ToolsMenu" anchor="last"/></action>
        <action id="GlslSupport.AllPipelines" class="com.glslsupport.ide.Actions$AllPipelines" text="Validate All GLSL Pipelines" icon="/icons/pipeline.svg"><add-to-group group-id="ToolsMenu" anchor="last"/></action>
        <action id="GlslSupport.Trace" class="com.glslsupport.ide.TraceInspector$Open" text="Show Include and Macro Trace" icon="/icons/inspector.svg"><add-to-group group-id="EditorPopupMenu" anchor="last"/></action>
    </actions>
</idea-plugin>
